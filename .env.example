# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Host port the app is exposed on: http://localhost:<HOST_PORT>
HOST_PORT=8080

# Docker image name/tag built (or pulled) for the frontend container.
# Change IMAGE_TAG to e.g. a published version (see .github/workflows/docker-publish.yml)
# to run a specific release instead of building locally.
IMAGE_NAME=camping-simulator-frontend
IMAGE_TAG=local
